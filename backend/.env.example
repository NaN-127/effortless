# Application Configuration
APP_NAME=typeless-api
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Infrastructure: PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=effortless
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/effortless

# Infrastructure: Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Sarvam AI Credentials & Settings
# Get your API key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_SPEECH_MODEL=saaras:v4
SARVAM_TRANSLATION_MODEL=mayura:v1
