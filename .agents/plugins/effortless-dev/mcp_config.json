{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "android-artemis": {
      "command": "python3",
      "args": [
        "-m",
        "artemis.mcp_server"
      ],
      "env": {
        "ANDROID_HOME": "${ANDROID_HOME:-/Users/nandu.rajeev/Library/Android/sdk}"
      }
    }
  }
}
